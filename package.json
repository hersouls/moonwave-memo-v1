    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
