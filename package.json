{
  "name": "moonwave-memo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "electron/out/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "knip": "knip --no-exit-code",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "npm run electron:build && electron .",
    "electron:preview": "npm run build && npm run electron:build && electron .",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --publish never",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && npm run electron:build && electron-builder --linux --publish never",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
