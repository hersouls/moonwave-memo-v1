    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
    "@sentry/react": "^10.43.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-bubble-menu": "^3.20.1",
